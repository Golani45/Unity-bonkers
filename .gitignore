# This .gitignore file should be placed at the root of your Unity project.
# --- Unity Folders ---
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# --- Memory Dumps ---
MemoryCaptures/

# --- Asset store packages ---
# Often it's better to ignore these and let Unity Package Manager handle them
/[Aa]ssets/AssetStoreTools*

# --- Autogenerated JetBrains Rider / Visual Studio files ---
.vs/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svclog
*.pdb
*.opendb
*.db
*.VC.db

# --- Unity3D Generated File ---
.DS_Store

# --- OS Generated ---
Thumbs.db
ehthumbs.db
Desktop.ini

# --- URP / Shader Graph specifics ---
# Usually these are generated into the Library folder, but sometimes 
# custom tools might create local caches.
*.shader test results

# --- Crashlytics ---
crashlytics-build.properties

# --- PlasticSCM (if used) ---
ignore.conf
