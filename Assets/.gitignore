# This .gitignore file should be placed at the root of your Unity project.
# --- Unity Folders ---
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# --- Memory Dumps ---
MemoryCaptures/

# --- Asset store packages ---
# Often it's better to ignore these and let Unity Package Manager handle them
/[Aa]ssets/AssetStoreTools*

# --- Autogenerated JetBrains Rider / Visual Studio files ---
.vs/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svclog
*.pdb
*.opendb
*.db
*.VC.db

# --- Unity3D Generated File ---
.DS_Store

# --- OS Generated ---
Thumbs.db
ehthumbs.db
Desktop.ini

# --- URP / Shader Graph specifics ---
# Usually these are generated into the Library folder, but sometimes 
# custom tools might create local caches.
*.shader test results

# --- Crashlytics ---
crashlytics-build.properties

# --- PlasticSCM (if used) ---
ignore.conf

# Large imported asset packs (local only)
Assets/Darth_Artisan/
Assets/Downtown Game Studio/
Assets/GrassFlowers/
Assets/JC_StylizedRocks_Lite/
Assets/PBR Ground Materials #1 [Dirt& Grass]/
Assets/_TerrainAutoUpgrade/

# Ignore everything inside Downloaded Packages
Assets/Downloaded Packages/**
# But keep the folder itself in the repo
!Assets/Downloaded Packages/
!Assets/Downloaded Packages/.gitkeep

# Ignore .meta files for ignored asset-pack folders
Assets/Darth_Artisan.meta
Assets/Downtown Game Studio.meta
Assets/GrassFlowers.meta
Assets/JC_StylizedRocks_Lite.meta
Assets/PBR Ground Materials #1 [Dirt& Grass].meta
Assets/_TerrainAutoUpgrade.meta
Assets/Downloaded Packages.meta











